<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NOT sandboxed: reading ~/Library/Safari/History.db needs Full Disk Access,
	     which the App Sandbox forbids. Distributed notarized + hardened, outside the
	     Mac App Store (like Stats, Ice, and similar FDA menu-bar utilities). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
